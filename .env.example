# Open-RAG-Stack — docker compose environment
# Copy to .env and fill in the two required values before running.
#
#   cp .env.example .env
#   docker compose up -d

# ── Required ──────────────────────────────────────────────────────────────────

# Absolute path to your pre-downloaded model directory.
# Run scripts/download-models.sh first to populate this directory.
# This path is mounted read-only into embedding, reranker, ingestion, and vllm.
# Expected layout:
#   <MODEL_DIR>/huggingface/   — HuggingFace model cache (embedding, reranker, LLM)
MODEL_DIR=<path-to-your-model-storage>

# HuggingFace model ID for the LLM served by vLLM.
# The model must already be downloaded into ${MODEL_DIR}/huggingface/ before starting.
# RTX 3090 (24 GB): Qwen/Qwen3-8B-Instruct  |  meta-llama/Llama-3.1-8B-Instruct
# L40S (48 GB):     Qwen/Qwen3-32B-Instruct  |  meta-llama/Llama-3.3-70B-Instruct (Q4)
LLM_MODEL=<hf-model-id>

# ── Optional ──────────────────────────────────────────────────────────────────

# Data-plane auth. Shared machine-to-machine token: ai-agent and ingestion require it on
# every non-health route; chat-ui, rag-admin and the helper scripts send it. Empty (default)
# leaves the data plane OPEN — fine for a single host on a trusted LAN. To lock it down,
# generate one and set it here (all services read the same value):
#   openssl rand -hex 32
# SERVICE_TOKEN=
#
# Compose runs ENVIRONMENT=development, so an empty SERVICE_TOKEN just means anonymous
# access (no fail-closed boot). In Kubernetes (ENVIRONMENT=production) the open services
# refuse to boot without a token unless you set ALLOW_ANONYMOUS=true for a trusted, isolated LAN.
# ALLOW_ANONYMOUS=false


# Browser-reachable base URL of the ingestion service, used by the ai-agent to
# build inline page-image links in chat citations. The user's browser must be
# able to reach this address (the host-mapped port, not the internal service
# name). Leave unset for text-only page citations (no inline diagram images).
# Example: INGESTION_PUBLIC_URL=http://<host-ip>:8002
# INGESTION_PUBLIC_URL=

# Fraction of GPU memory vLLM may use. Default 0.70 leaves room for the
# embedding and reranker services on the same card (RTX 3090, 24 GB). On a
# dedicated or larger GPU (e.g. L40S, 48 GB) raise toward 0.90 for more KV cache.
# VLLM_GPU_UTIL=0.70

# Chunking (ingestion). CHUNK_SIZE/OVERLAP are in characters. Changing these
# requires re-ingesting the corpus. Phase 6 found 256 best for retrieval recall
# (page-level hit@5 0.820 vs 0.770 at 512; 1024 was worse). Defaults: 256 / 64.
# CHUNK_SIZE=256
# CHUNK_OVERLAP=64

# Query rewriting before retrieval (ai-agent). Off by default — Phase 5 found it
# net-negative for dense retrieval with nomic. Set true to re-enable.
# QUERY_REWRITE=false

# Drop folder for bulk auto-ingest. Files placed in <WATCH_HOST_DIR>/<vendor>/
# are ingested automatically; the subfolder name becomes both the collection and
# the vendor tag. To enable, set WATCH_HOST_DIR to a host path AND WATCH_DIR=/mnt/watch.
# WATCH_HOST_DIR=/mnt/labfiles/rag-watch
# WATCH_DIR=/mnt/watch
# WATCH_POLL_INTERVAL=60

# Shared document store. When enabled, ingestion saves each original upload as
# <store>/<vendor>/<filename> (browsable, e.g. on an NFS share) and serves it back at
# /documents/{id}/file so chat citations link to the source. DOC_STORE_HOST is the host
# path (mounted to /mnt/docstore in the container); DOC_STORE must be that container path.
# Leave unset to keep originals inside the ingestion volume (citations stay text-only).
# DOC_STORE_HOST=/mnt/labfiles/rag-docs
# DOC_STORE=/mnt/docstore

# RAG Admin UI (port 8005) authentication. Set BOTH to require HTTP Basic Auth on
# every page and write/delete action (the /health probe stays open). Leave blank
# for no auth (default). Keep network access LAN-scoped regardless.
# ADMIN_USER=admin
# ADMIN_PASSWORD=<choose-a-strong-password>

# ── Chat UI (port 3001) ───────────────────────────────────────────────────────
# The first-party chat front-end (replaces Open-WebUI). Defaults work out of the
# box for LAN testing; set these for a real / multi-user deployment.

# Stable random secret so login sessions survive restarts. REQUIRED when CHAT_ENV=production.
# Generate with: openssl rand -hex 32
# SESSION_SECRET=

# Fail-closed production mode — refuses to boot without SESSION_SECRET and an auth method.
# CHAT_ENV=production

# White-label the UI.
# BRAND_NAME=Acme Assistant
# BRAND_PRIMARY_COLOR=#2563eb

# OIDC single sign-on (Entra / Okta / Google / Keycloak). Set OIDC_ENABLED=true and fill these.
# The redirect URI must be registered with your IdP and reachable by the user's browser.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<app-client-id>
# OIDC_CLIENT_SECRET=<app-client-secret>
# OIDC_GROUP_ROLES=rag-admins:admin,rag-users:user
# OIDC_REDIRECT_URI=http://<host-ip>:3001/api/auth/oidc/callback

# Break-glass admin — a recovery login independent of the user table and the IdP.
# BREAK_GLASS_ADMIN_USER=breakglass
# BREAK_GLASS_ADMIN_PASSWORD=<choose-a-strong-password>
